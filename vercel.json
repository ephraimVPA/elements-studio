{
  "rewrites": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "elementsstud.io" }],
      "destination": "/home/:path*"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.elementsstud.io" }],
      "destination": "/home/:path*"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "(?<sub>[^.]+)\\.elementsstud\\.io" }],
      "destination": "/sites/:sub/:path*"
    }
  ]
}
